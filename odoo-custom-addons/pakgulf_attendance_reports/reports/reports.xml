<odoo>

    <record id="report_pak_emp_att_paperformat" model="report.paperformat">
        <field name="name">Purchase Requisition Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">19</field>
        <field name="dpi">90</field>
    </record>


      <!-- Company Summary Action Qweb-PDF -->
        <record id="pakgulf_monthly_emp_wise_report" model="ir.actions.report">
            <field name="name">Pak Gulf Employee Attendance (Report PDF)</field>
            <field name="model">pakgulf.emp.wise.attendance</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pakgulf_attendance_reports.   </field>
            <field name="report_file">pakgulf_attendance_reports.monthly_dept_wise_report_doc</field>
            <field name="binding_model_id" ref="model_pakgulf_emp_wise_attendance"/>
            <field name="paperformat_id" ref="pakgulf_attendance_reports.report_pak_emp_att_paperformat"/>
            <field name="binding_type">report</field>
        </record>



        <!-- Company Summary Action EXCEL XLSX -->
        <record id="pakgulf_monthly_emp_wise_xlsx" model="ir.actions.report">
            <field name="name">Pak Gulf Employee Attendance Report (XLSX)</field>
            <field name="model">pakgulf.emp.wise.attendance</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">pakgulf_attendance_reports.monthly_report_xls</field>
            <field name="report_file">pakgulf_attendance_reports.monthly_report_xls</field>
<!--            <field name="binding_model_id" ref="model_pak_company_summary"/>-->
            <field name="binding_type">report</field>
        </record>
   


</odoo>
<odoo>
    <data>
        <template id="internal_layout_payslip">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <div class="header">
                <t t-if="not o" t-set="o" t-value="doc"/>
                <t t-if="not company">
                    <!-- Multicompany -->
                    <t t-if="company_id">
                        <t t-set="company" t-value="company_id"/>
                    </t>
                    <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                        <t t-set="company" t-value="o.company_id.sudo()"/>
                    </t>
                    <t t-else="else">
                        <t t-set="company" t-value="res_company"/>
                    </t>
                </t>
                <div class="row">
                    <div class="col-4">
                        <img t-if="not company.logo" t-att-src="'/web/static/src/img/placeholder.png'"
                             height="70"
                             border="1" width="70"/>
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             height="70"
                             border="1" width="70"/>
                    </div>

                    <div class="col-4" style="font-size:20px; text-align:center">
                        <b t-esc="company.name"/>
                        <br/>
                        <h6>
                            <strong>Attendence Register Employee Wise</strong>
                        </h6>
                    </div>
                    <div class="col-4" style="font-size:13px; text-align:right">
                        <br/>
                        <span>
                            Generated By :&#160;
                            <t t-esc="user.name"/>
                        </span>
                        <br/>
                        <span>
                            Printed On :&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y / %H:%M')"/>
                        </span>
                    </div>
                    <div class="col-4">

                    </div>
                </div>
                <t t-set="dat" t-value="form"/>
                <p>
                    <span>From Date</span>
                    <span t-esc="dat['start_date']"/>
                    <span>To Date</span>
                    <span t-esc="dat['end_date']"/>

                </p>
                <style class="text/css">
                    .main_warper {
                    width: 1000px;
                    margin: 0px auto;
                    }
                    .main_div {
                    width: 100%;
                    }
                    .main_div_1{
                    width: 100%;
                    border: 1px solid black;
                    }
                    .left_div {
                    width: 50%;
                    float: left;
                    }
                    .right_div {
                    width: 50%;
                    float: right;
                    }
                    table {
                    font-size: 10px;
                    }
                    tr {
                    font-size: 10px;
                    }
                    th {
                    border: 1px solid black;
                    }
                    td {
                    text-align: center;
                    margin-top: 10px;
                    border: 1px solid black;
                    }
                    tr.hide_all > td, td.hide_all{
                    border: 0;
                    }
                </style>
                <table style="width: 100%">
                    <t t-set="serial" t-value="0"/>
                </table>
            </div>
            <div class="article">
                <t t-out="0"/>
            </div>
        </template>

        <template id="monthly_dept_wise_report_doc">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="container mt-4">
                        <div class="row">
                            <div class="col-6" >
                                <span>Employee Name:</span>
                                <br/>
                                <span>Employee Code:</span>
                                <br/>
                                <span>Employee Department:</span>
                                <br/>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <h2>Employee Attendance Report</h2>
                                <div class="calendar">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Sun</th>
                                                <th>Mon</th>
                                                <th>Tue</th>
                                                <th>Wed</th>
                                                <th>Thu</th>
                                                <th>Fri</th>
                                                <th>Sat</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="range(1, 6)" t-as="week">
                                                <tr>
                                                    <t t-foreach="range(0, 7)" t-as="day">
                                                        <td>
                                                            <t t-set="current_date" t-value="(week - 1) * 7 + day + 1"/>
                                                            <div class="date-box">
                                                                <span class="date">
                                                                    <t t-esc="current_date"/>
                                                                </span>
                                                                <div class="attendance-data">
                                                                    <span>
                                                                        Holiday
                                                                    </span>
                                                                    <br/>
                                                                    <span>
                                                                        Time In:
                                                                    </span>
                                                                    <br/>
                                                                    <span>
                                                                        Time Out:
                                                                    </span>
                                                                    <br/>
                                                                    <span>
                                                                        Worked Hours:
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>



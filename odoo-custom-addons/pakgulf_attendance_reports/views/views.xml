<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="hr_attendance_view_calendar" model="ir.ui.view">
        <field name="name">hr.attendance.calendar</field>
        <field name="model">hr.attendance</field>
        <field eval="2" name="priority"/>
        <field name="arch" type="xml">
            <calendar string="Attendance Calendar" date_start="check_in" date_stop="check_out">
                <!-- Define fields to be shown in the calendar -->
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
<!--                <field name="late_emp"/>-->
                <field name="worked_hours"/>
<!--                <field name="overtime"/>-->
                <!-- Define any other fields you want to display -->
            </calendar>
        </field>
    </record>
    <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="context">{"search_default_today":1}</field>
        <field name="search_view_id" ref="hr_attendance_view_calendar"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No attendance records found
            </p>
            <p>
                The attendance records of your employees will be displayed here.
            </p>
        </field>
    </record>
</odoo>
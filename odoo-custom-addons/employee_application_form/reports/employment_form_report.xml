<!--                                <t t-esc="doc.reason"/>-->
<!--                            </td>-->
<!--                        </tr>-->
                    </table>


                </div>


                <div class="page">

                    <h2 class="text-center" style="text-decoration: underline; text-align: center;">Declaration Form
                    </h2>

                    <p>
                        <strong>Is your visa application in process?</strong>
                    </p>
                    <ul>
                        <li>
                            <t t-if="doc.visa_status == 'yes'">Yes</t>
                            <t t-if="doc.visa_status == 'no'">No</t>
                        </li>
                    </ul>

                    <p>
                        <strong>Have you applied to any foreign/local university?</strong>
                    </p>
                    <ul>
                        <li>
                            <t t-if="doc.additional_uni_status == 'yes'">Yes</t>
                            <t t-if="doc.additional_uni_status == 'no'">No</t>
                        </li>
                    </ul>

                    <p>
                        <strong>Are you authorized to work in Pakistan?</strong>
                    </p>
                    <ul>
                        <li>
                            <t t-if="doc.work_status_in_pk == 'yes'">Yes</t>
                            <t t-if="doc.work_status_in_pk == 'no'">No</t>
                        </li>
                    </ul>

                    <h3 style="text-align:center;">Acknowledgment</h3>
                    <p>
                        I confirm that the information I have provided in this declaration form is correct and complete
                        as of the date mentioned below. I understand and accept that if I knowingly withhold or provide
                        false or misleading information, my application may be rejected or my employment terminated.
                    </p>

                    <p>
                        <strong>Name in Block Letters:</strong>
                        <t t-esc="doc.name_in_block_letter"/>
                    </p>
                    <!--                    <t t-if="doc.date_signature">-->
                    <p>
                        <strong>Date Signature:_______________________</strong>
                    </p>

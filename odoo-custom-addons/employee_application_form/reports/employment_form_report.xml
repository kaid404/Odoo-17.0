                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.position_applied.name"/>
                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.expected_salary"/>
                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">

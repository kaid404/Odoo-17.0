                    </table>
                    <h4>
                        <strong>Applicant&#39;s Information:</strong>
                    </h4>
                    <table class="table table-bordered"
                           style="width:100%; border-collapse: collapse; font-size:12px; border: 1px solid black;">
                        <tr style="border-bottom: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black; width: 25%;">Name:</td>
                            <td style="padding: 6px;border: 1px solid black; width: 25%;">
                                <t t-esc="doc.name"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black; width: 25%;">
                                Qualification (Recent):
                            </td>
                            <td style="padding: 6px;border: 1px solid black; width: 25%;">
                                <t t-esc="doc.qualification_recent"/>
                            </td>


                        </tr>

                        <tr style="border-bottom: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Date of Birth:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.date_of_birth"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Institute Name:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.institute_name"/>
                            </td>


                        </tr>


                        <tr style="border-bottom: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">CNIC #:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.cnic_number"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Current Company:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.current_company"/>
                            </td>

                        </tr>

                        <tr style="border-bottom: 1px solid black;">

                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Mobile #:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.mobile_no"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Current Job Title:</td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.current_job"/>
                            </td>

                        </tr>

                        <tr style="border: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;border: 1px solid black;">
                                Email ID:
                            </td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.email_id"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Total Work
                                Experience:
                            </td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.total_work_experience"/>
                            </td>


                        </tr>

                        <tr style="border: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;border: 1px solid black;">
                                Marital Status:
                            </td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.marital_status"/>
                            </td>
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Father&#39;s
                                Occupation:
                            </td>
                            <td style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.father_occupation"/>
                            </td>


                        </tr>
                        <tr style="border-bottom: 1px solid black;">
                            <td style="font-weight: bold; padding: 6px;border: 1px solid black;">Current Address:</td>
                            <td colspan="3" style="padding: 6px;border: 1px solid black;">
                                <t t-esc="doc.current_address"/>
                            </td>
                        </tr>
                    </table>


                    <p>
                        <strong>Have any of your relatives ever been employed with this company?</strong>
                        <span style="margin-left:10px;">
                            <t t-if="doc.relatives_employed == 'yes'">Yes</t>
                            <t t-if="doc.relatives_employed == 'no'">No</t>
                        </span>
                    </p>

                    <p>
                        <strong>Have you ever been employed with this company?</strong>
                        <span style="margin-left:10px;">
                            <t t-if="doc.previously_employed == 'yes'">Yes</t>
                            <t t-if="doc.previously_employed == 'no'">No</t>
                        </span>
                    </p>

                    <p>
                        <strong>Relatives/Friends/Colleagues you know in this company:</strong>
                    </p>
                    <table class="table" style="width:100%; border:1px solid black; border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="border:1px solid black;">NAME OF EMPLOYEE</th>
                                <th style="border:1px solid black;">RELATIONSHIP</th>
                                <th style="border:1px solid black;">POSITION HELD</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.name_1"/>
                                </td>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.relationship_1"/>
                                </td>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.position_held_1"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.name_2"/>
                                </td>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.relationship_2"/>
                                </td>
                                <td style="border:1px solid black; text-align: center;">
                                    <t t-esc="doc.position_held_2"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <p>
                        <strong>How did you get job information?</strong>
                        <t t-esc="doc.info_source"/>
                    </p>

                    <p>
                        <strong>Applicant&#39;s Signature:</strong>
                    </p>
                    <t t-if="doc.signature">
                        <img t-att-src="'data:image/png;base64,%s' % doc.signature" style="width:150px;"/>
                    </t>

                    <table class="table table-bordered"
                           style="width:100%; border-collapse: collapse; border: 1px solid black; font-size:12px;">
                        <thead>
                            <tr>
                                <th>
                                    Team Name
                                </th>
                                <th>
                                    Interviewer Name
                                </th>
                                <th>
                                    Interview Status
                                </th>
                                <th>
                                    Reason
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.team_name"/>
                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.Interviewer_name"/>
                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.interview_status"/>
                                </td>
                                <td style="border: 1px solid black; padding: 6px; text-align: center;">
                                    <t t-esc="doc.reason"/>
                                </td>
                            </tr>
                        </tbody>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_summary_report_wizard_form" model="ir.ui.view">
        <field name="name">leave.summary.report.wizard.form</field>
        <field name="model">leave.summary.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Leave Summary Report">
                <sheet>
                    <group>
                        <field name="report_type"/>
                        <field name="leave_type_ids" widget="many2many_tags"/>
                        <field name="company_id" invisible="report_type != 'company'"/>
                        <field name="employee_ids" widget="many2many_tags" invisible="report_type != 'employees'"/>
                        <field name="department_ids" widget="many2many_tags" invisible="report_type != 'department'"/>
                        <field name="team_ids" widget="many2many_tags" invisible="report_type != 'team'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="print_report" type="object" string="Print Report" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_summary_report_wizard" model="ir.actions.act_window">
        <field name="name">Leave Summary Report</field>
        <field name="res_model">leave.summary.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_leave_summary_root" name="Leave Reports"/>
    <menuitem id="menu_leave_summary_report"
              name="Leave Summary"
              parent="menu_leave_summary_root"
              action="action_leave_summary_report_wizard"/>
</odoo>

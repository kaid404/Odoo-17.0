<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_employee_increment_wizard_form" model="ir.ui.view">
        <field name="name">employee.increment.wizard.form</field>
        <field name="model">employee.increment.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Increment">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="employee_ids" widget="one2many_list">
                        <tree editable="top">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="wage" optional="hide"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="apply_increment" string="Apply Increment" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_increment" model="ir.actions.act_window">
        <field name="name">Employee Increment</field>
        <field name="res_model">employee.increment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_increment_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_employee_increment)d" string="Employee Increment" type="action"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Increment Details">
                    <field name="increment_detail_ids" widget="one2many_list">
                        <tree editable="top">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="wage" optional="hide"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                    <field name="increment_detail_ids" invisible="1"/>
                </page>
            </xpath>
        </field>
    </record>


    <record id="action_employee_increment_from_list" model="ir.actions.server">
        <field name="name">Employee Increment</field>
        <field name="model_id" ref="hr_contract.model_hr_contract"/>
        <field name="binding_model_id" ref="hr_contract.model_hr_contract"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">if records: action = records.action_register_cpr()
        </field>
    </record>
</odoo>

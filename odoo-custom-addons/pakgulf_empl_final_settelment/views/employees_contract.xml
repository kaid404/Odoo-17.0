<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_inherit" model="ir.ui.view">
        <field name="name">hr.contract.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]/field[@name='structure_type_id'][2]" position="after">
                <field name="final_settlement_structure"
                       domain="[('check', '=', True)]"/>
<!--                       invisible="final_settlement_structure == False"/>-->
            </xpath>
            <xpath expr="//field[@name='structure_type_id'][2][@groups='hr_contract.group_hr_contract_manager']"
                   position="attributes">
                <attribute name="domain">[('check', '=', False)]
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="view_hr_payroll_structure_type_inherit" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.inherit</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_structure_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]/field[@name='wage_type']" position="after">
                <field name="check"/>
            </xpath>
        </field>
    </record>
</odoo>
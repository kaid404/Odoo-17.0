<odoo>
    <record id="view_budget_information_form" model="ir.ui.view">
        <field name="name">Job Specifications Form</field>
        <field name="model">budget.information</field>
        <field name="arch" type="xml">
            <form string="Budget Information Form">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_budget_information_tree" model="ir.ui.view">
        <field name="name">Budget Information Tree</field>
        <field name="model">budget.information</field>
        <field name="arch" type="xml">
            <tree string="Budget Information Tree">
                <field name="name"/>
            </tree>
        </field>
    </record>

        <record id="budget_other" model="budget.information">
        <field name="name">Other</field>
    </record>


    <record id="action_budget_information_tree" model="ir.actions.act_window">
        <field name="name">Budget Information Form</field>
        <field name="res_model">budget.information</field>
        <field name="view_mode">form,tree</field>
        <field name="view_id" ref="view_budget_information_tree"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the first Budget Information
            </p>
        </field>
    </record>
    <menuitem id="menu_budget_information_tree"
              name="Budget Information"
              parent="menu_configuration"
              sequence="40"
              action="action_budget_information_tree"/>
</odoo>
        <t t-name="ReceiptHeaderInherit" t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension" owl="1">

            <xpath expr="//img" position="replace"></xpath>
             <xpath expr="//div[hasclass('pos-receipt-contact')]" position="replace">
                <div class="pos-receipt-contact">
                    <div class="company-name">
                    <span>Unique Hotel and Resorts PLC</span><br/>
                    <span>UHRL Lounge-HSIA</span>
                </div>
                <div class="ul-authentic">
                    Reg.Add: Plot No #01,CWN(B), Road #45
                    <br/>
                    Gulshan-2, Dhaka-1212, Bangladesh
                    <br/>
                    <b>Tell:</b>8802222291988, <b>Fax:</b>8802222296661
                    <br/>
                    <b>BIN:</b>000000487-0002, <b>MUSHAK:</b>6.3
                </div>
                ......................................................................................
                <ul class="list-col-6">
                    <li style="text-align:left;font-weight:bold;">Invoice No.</li>
                    <li style="text-align:right;"><span t-esc="props.data.trackingNumber"/></li>

                </ul>
                <ul class="list-col-6">
                    <li style="text-align:left;font-weight:bold;">Date</li>
                    <li style="text-align:right;" t-esc="props.data.date"></li>
                </ul>

                </div>
            </xpath>
        </t>

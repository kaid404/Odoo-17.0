        <xpath expr="//OrderWidget" position="after">
            <div t-if="props.data.tax_details.length > 0">
                    <br/>
                <div class="text-center">--------------------------------</div>

                <div>
                    <t t-log="props.data"/>
                    <t t-log="props.data"/>
                    <b>Untaxed Amount</b>

                    <span t-esc="props.formatCurrency(props.data.total_without_tax, false)" class="pos-receipt-right-align"/>

                </div>
                <div t-if="props.data.tax_details.length > 0">
                    <ul t-foreach="props.data.tax_details" t-as="tax" t-key="tax.tax.id">
                        <li><span t-esc="tax.tax.name"/>
                        <span t-esc="props.formatCurrency(tax.amount, false)" class="pos-receipt-right-align"/>
                        </li>
                    </ul>
                </div>
                <div class="text-center">--------------------------------</div>
                <div>
                    <b>TOTAL</b>
                    <span t-esc="props.formatCurrency(props.data.amount_total)" class="pos-receipt-right-align"/>
                </div>
                <div t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                    <t t-esc="line.name"/>
                    <span t-esc="props.formatCurrency(line.amount, false)" class="pos-receipt-right-align"/>
                </div>
                <div class="receipt-change mt-2" t-if="props.data.change">
                    CHANGE
                    <span t-esc="props.formatCurrency(props.data.change)" class="pos-receipt-right-align"/>
                </div>

            </div>

        </xpath>

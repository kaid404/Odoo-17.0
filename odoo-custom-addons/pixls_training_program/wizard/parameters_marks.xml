<odoo>
    <record id="view_parameters_marks_wizard" model="ir.ui.view">
        <field name="name">parameters.marks.wizard.form</field>
        <field name="model">parameters.marks</field>
        <field name="arch" type="xml">
            <form string="Parameters Marks">
                <group>
                    <group>
                        <field name="training_program_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="parameters_line_id" readonly="1" invisible="1"/>
                        <field name="parameters_id" readonly="1"/>
                        <field name="jury_member_id" force_save="1" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Students">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="student_id"/>
                                <field name="marks"/>
                                <field name="remarks"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parameters_marks_wizard" model="ir.actions.act_window">
        <field name="name">Parameters Marks</field>
        <field name="res_model">parameters.marks</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
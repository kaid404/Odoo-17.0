<odoo>
    <record id="view_assignment_sheet_wizard" model="ir.ui.view">
        <field name="name">assignment.sheet.wizard.form</field>
        <field name="model">assignment.sheet</field>
        <field name="arch" type="xml">
            <form string="Add Marks">
                <group>
                    <group>
                        <field name="training_program_id" readonly="1"/>
                        <field name="assignment_id" readonly="1"/>
                        <field name="week" readonly="1"/>
                    </group>
                    <group>
                        <field name="goal_ids" widget="many2many_tags" invisible="1"/>
                        <field name="goal_id" domain="[('id', 'in', goal_ids)]"/>
                    </group>
                </group>
                <notebook>
                    <page string="Assignments">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="student_id"/>
                                <field name="marks"/>
                                <field name="remarks"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assignment_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Assignment Sheet</field>
        <field name="res_model">assignment.sheet</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
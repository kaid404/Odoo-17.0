<odoo>
    <record id="training_program_form_view" model="ir.ui.view">
        <field name="name">Training Program</field>
        <field name="model">training.program</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
<!--                        <field name="marks"/>-->
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="training_program_list_view" model="ir.ui.view">
        <field name="name">Training Program</field>
        <field name="model">training.program</field>
        <field name="arch" type="xml">
            <tree>

                <field name="name"/>
<!--                <field name="marks"/>-->
            </tree>
        </field>
    </record>
    <record id="action_training_program" model="ir.actions.act_window">
        <field name="name">Training Program</field>
        <field name="res_model">training.program</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_training_program" name="Training Program" action="action_training_program" parent="menu_pixls_training_program_configuration" sequence="100"/>


</odoo>
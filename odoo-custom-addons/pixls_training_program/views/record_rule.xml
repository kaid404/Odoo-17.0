<odoo>
    <data>
        <record id="assignment_goals_user_rule" model="ir.rule">
            <field name="name">Assignment Goals: Own Records Only</field>
            <field name="model_id" ref="model_assignment_goals"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="assignment_goals_admin_rule" model="ir.rule">
            <field name="name">Assignment Goals: Admin Sees All</field>
            <field name="model_id" ref="model_assignment_goals"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('pixls_training_program.group_training_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <record id="assignment_data_user_rule" model="ir.rule">
            <field name="name">Assignments: Own Records Only</field>
            <field name="model_id" ref="model_assignment_data"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="assignment_data_admin_rule" model="ir.rule">
            <field name="name">Assignments: Admin Sees All</field>
            <field name="model_id" ref="model_assignment_data"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('pixls_training_program.group_training_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


    </data>
</odoo>

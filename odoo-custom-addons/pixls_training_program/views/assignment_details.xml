<odoo>

    <record id="view_assignment_details_tree" model="ir.ui.view">
        <field name="name">assignment.details.tree</field>
        <field name="model">assignment.details</field>
        <field name="arch" type="xml">
            <tree string="Assignment Details">
                <field name="training_program_id" readonly="1"/>
                <field name="assignment_id" readonly="1"/>
                <field name="week" readonly="1"/>
                <field name="weightage" widget="percentage" readonly="1"/>
                <field name="total_marks" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_assignment_details_form" model="ir.ui.view">
        <field name="name">assignment.details.form</field>
        <field name="model">assignment.details</field>
        <field name="arch" type="xml">
            <form string="Assignment Details">
                <group>
                    <group>
                        <field name="training_program_id" readonly="1"/>
                        <field name="assignment_id" readonly="1"/>
                        <field name="week" readonly="1"/>
                    </group>
                    <group>
                        <field name="total_marks"/>
                        <field name="weightage" widget="percentage"/>
                    </group>
                </group>
                <notebook>
                    <page string="Students">
                        <field name="assignment_details_lines" readonly="1" delete="false">
                            <tree editable="bottom">
                                <field name="student_id"/>
                                <field name="marks"/>
                                <field name="total_marks"/>
                                <field name="weightage" widget="percentage"/>
                                <field name="percentage" widget="percentage"/>
                                <field name="remarks"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_assignment_details" model="ir.actions.act_window">
        <field name="name">Assignment Sheet</field>
        <field name="res_model">assignment.details</field>
        <field name="view_mode">form,tree</field>
        <field name="target">new</field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_absent_view_form" model="ir.ui.view">
        <field name="name">employee.attendance.absent.form</field>
        <field name="model">employee.attendance.absent</field>
        <field name="arch" type="xml">
            <form string="Employee Outward Gatepass">
                <header>
                                    <button name="make_absent" string="Calculate" type="object"/>
<!--                                    <button name="action_time_out" string="Check Out" type="object"/>-->


                </header>
                <sheet>
<!--                    <field name="image" widget="image" class="oe_avatar" t-att-src="record.image" readonly="0"/>-->
                    <group>
                        <group>
                            <field name="badge_id"/>
                            <field name="date" readonly="1"/>
<!--                            <field name="time_out" readonly="1"/>-->
<!--                            <field name="time_in"/>-->
<!--                            <field name="total_time"/>-->
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="department"/>
<!--                            <field name="gate_pass_type"/>-->
<!--                            <field name="description"/>-->
                            <field name="amount_deduc"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="employee_absent_view_tree" model="ir.ui.view">
        <field name="name">employee.attendance.absent.Tree.View</field>
        <field name="model">employee.attendance.absent</field>
        <field name="arch" type="xml">
            <tree string="Record rules">
                <field name="badge_id"/>
                <field name="date"/>
<!--                <field name="time_out"/>-->
<!--                <field name="time_in"/>-->
                <field name="name"/>
                <field name="department"/>
<!--                <field name="gate_pass_type"/>-->
<!--                <field name="description"/>-->
            </tree>
        </field>
    </record>
    <record id="employee_absent_window_action" model="ir.actions.act_window">
        <field name="name">Employee Gatepass</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.attendance.absent</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="employee_absent_view_tree"/>
        <!--        <field name="target">new</field>-->
    </record>


    <record model="ir.cron" id="absent_cron">
		<field name="name">Absent Employee</field>
		<field name="model_id" ref="model_employee_attendance_absent"/>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
		<field name="state">code</field>
		<field name="code">model.make_absent()</field>
	</record>



    <record model="ir.cron" id="attendance_cron">
		<field name="name">Miss Check Out</field>
		<field name="model_id" ref="model_hr_attendance"/>
		<field name="interval_number">1</field>
		<field name="interval_type">days</field>
		<field name="numbercall">-1</field>
		<field name="doall" eval="False"/>
		<field name="state">code</field>
		<field name="code">model.compute_miss_checkout()</field>
	</record>




    <menuitem id="employee_absent_menu_root"
              name="Absent Employee"
              parent="hr_attendance.menu_hr_attendance_view_attendances"
              action="employee_absent_window_action"
              sequence="20"/>


</odoo>
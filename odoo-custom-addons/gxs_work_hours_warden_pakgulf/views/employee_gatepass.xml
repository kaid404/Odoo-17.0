<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_gatepass_view_form" model="ir.ui.view">
        <field name="name">employee.gatepass.form</field>
        <field name="model">employee.gatepass</field>
        <field name="arch" type="xml">
            <form string="Employee Outward Gatepass">
                <header>
                                    <button name="action_time_in" string="Calculate" type="object"/>
                                    <button name="action_time_out" string="Check Out" type="object"/>


                </header>
                <sheet>
<!--                    <field name="image" widget="image" class="oe_avatar" t-att-src="record.image" readonly="0"/>-->
                    <group>
                        <group>
                            <field name="badge_id"/>
                            <field name="date" readonly="1"/>
                            <field name="time_out" readonly="1"/>
                            <field name="time_in"/>
                            <field name="total_time"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="department"/>
                            <field name="gate_pass_type"/>
                            <field name="description"/>
                            <field name="amount_deduc"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="employee_gatepass_view_tree" model="ir.ui.view">
        <field name="name">employee.gatepass.Tree.View</field>
        <field name="model">employee.gatepass</field>
        <field name="arch" type="xml">
            <tree string="Record rules">
                <field name="badge_id"/>
                <field name="date"/>
                <field name="time_out"/>
                <field name="time_in"/>
                <field name="name"/>
                <field name="department"/>
                <field name="gate_pass_type"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <record id="employee_gatepass_window_action" model="ir.actions.act_window">
        <field name="name">Employee Gatepass</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.gatepass</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="employee_gatepass_view_tree"/>
        <!--        <field name="target">new</field>-->
    </record>

    <menuitem id="employee_gatepss_menu_root"
              name="Employee Outward Gatepass"
              parent="hr_attendance.menu_hr_attendance_view_attendances"
              action="employee_gatepass_window_action"
              sequence="20"/>


</odoo>
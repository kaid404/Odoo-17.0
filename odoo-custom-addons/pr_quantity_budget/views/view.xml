<odoo>
    <!-- views/quantity_budget_views.xml -->

    <record id="view_quantity_budget_tree" model="ir.ui.view">
        <field name="name">quantity.budget.tree</field>
        <field name="model">quantity.budget</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_quantity_budget_form" model="ir.ui.view">
        <field name="name">quantity.budget.form</field>
        <field name="model">quantity.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Done" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset" class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button name="action_exceed_qty" string="Exceed" type="object" class="oe_highlight"
                            invisible="state != 'done'" groups="pr_quantity_budget.group_exceed_button"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="department_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Qty Budget Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="warehouse_id" column_invisible="1"/>
                                    <field name="location_id"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <!--                            <field name="department_id"/>-->
                                    <field name="rate"/>
                                    <field name="total_quantity"/>
                                    <field name="ordered_quantity"/>
                                    <field name="remaining_quantity"/>
                                    <field name="consumed_percentage" widget="percentage"/>
                                    <button name="open_related_lines" string="Open Related Lines" type="object" class="btn-primary"/>
                                </tree>
                            </field>

                            <group>
                                <group></group>
                                <table class="table table-bordered 1px solid black" style="width:30%; font-size:16px" align="right">
                                    <tr>
                                        <td style="width:48%;">
                                            <strong>Total Budgeted Value:</strong>
                                        </td>
                                        <td style="width:2%;">
                                        </td>
                                        <td>
                                            <b style="text-align:left; width:50%;">
                                                <field name="total_budget_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:60%;">
                                            <strong>Utilized Budgeted Amount:</strong>
                                        </td>
                                        <td style="width:2%;">
                                        </td>
                                        <td>
                                            <b style="width:50%;" class="oe_title">
                                                <field name="utilized_budget_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:70%;">
                                            <strong>Available Budgeted Amount:</strong>
<!--                                            <strong> </strong>-->
                                        </td>
                                        <td style="width:2%;">
                                        </td>
                                        <td>
                                            <b style="text-align:left; width:50%;">
                                                <field name="available_budget_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="width:70%;">
                                            <strong>Total Consumed:</strong>
<!--                                            <strong> </strong>-->
                                        </td>
                                        <td style="width:2%;">
                                        </td>
                                        <td>
                                            <b style="text-align:left; width:50%;">
                                                <field name="total_consumed_percentage" widget="percentage"/>
                                            </b>
                                        </td>
                                    </tr>

                                </table>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>
    <record id="view_quantity_budget_exceed_wizard_form" model="ir.ui.view">
        <field name="name">quantity.budget.exceed.wizard.form</field>
        <field name="model">quantity.budget.exceed.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="budget_id" invisible="1"/>
                        <field name="product_id" widget="many2many_tags"/>
                        <field name="exceed_qty"/>
                        <field name="note"/>
                        <field name="available_product_ids" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="OK" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="group_exceed_button" model="res.groups">
        <field name="name">PR Budget Exceed</field>
    </record>
    <record id="action_quantity_budget" model="ir.actions.act_window">
        <field name="name">Quantity Budgets</field>
        <field name="res_model">quantity.budget</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_quantity_budget_tree"/>
    </record>
    <menuitem id="menu_quantity_budget"
              name="Quantity Budgets"
              parent="purchase_request.parent_menu_purchase_request"
              action="action_quantity_budget"
              sequence="40"/>

    <record id="seq_quantity_budget" model="ir.sequence">
        <field name="name">Quantity Budget Reference</field>
        <field name="code">quantity.budget</field>
        <field name="prefix">QB/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="invoice_retailer_report_with_weight_template">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat" />
            <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->

            <h2><strong>Sales Tax Invoice</strong></h2>
            <div class="row mt32 mb32">
                <div class="col-6"></div>
                <div t-if="doc.invoice_date" class="col-3">
                    <strong>Date</strong>
                    <p class="m-0" t-field="doc.invoice_date" />
                </div>
                <div t-if="doc.name" class="col-3">
                    <strong>Invoice #</strong>
                    <p t-esc="doc.name" />
                </div>
            </div>
            <div class="row" style="margin-top: 5px;">
                <div class="col-6">
                    <strong>Bill To</strong>
                    <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' />
                </div>
                <div class="col-6">
                    <strong>Ship To</strong>
                    <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' />
                </div>
            </div>

            <div class="page">
                <div class="oe_structure" />

                <!--  Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any(l.discount for l in doc.invoice_line_ids)" />

                <table class="table table-sm o_main_table" style="margin-top: 15px;">
                    <!--  In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group;">
                        <tr>
                            <!--                             <th name="th_code" class="text-center">Item Code</th> -->
                            <th width="40%" style="font-size: 13px;" name="th_description" class="text-left">Description</th>
                            <th width="10%" style="font-size: 13px;" name="th_lot" class="text-left">Lot# &amp; Expiry</th>
                            <!--                             <th name="th_exp_date" class="text-center">Expiry Date</th> -->
                            <th width="5%" style="font-size: 13px;" name="th_quantity" class="text-center">Qty</th>
                            <th width="5%" style="font-size: 13px;" name="th_quantity" class="text-center">Weight</th>
                            <th width="5%" style="font-size: 13px;" name="th_mrp" class="text-center">MRP</th>
                            <th width="5%" style="font-size: 13px;" name="th_tp" class="text-center">TP</th>
                            <th width="5%" style="font-size: 13px;" name="th_priceunit" class="text-center">Rate</th>
                            <th width="6%" style="font-size: 13px;" name="th_discount" t-if="display_discount" class="text-center" groups="product.group_discount_per_so_line">
                                <span>Discount</span>
                            </th>
                            <th width="6%" style="font-size: 13px;" name="th_subtotal" class="text-center">Amount EXCL ST</th>
                            <th width="6%" style="font-size: 13px;" name="th_sh_st_rate" class="text-center">ST Rate</th>
                            <th width="6%" style="font-size: 13px;" name="th_tax_amount" class="text-center">ST Amount</th>
                            <th width="6%" style="font-size: 13px;" name="th_sh_incl_st" class="text-center">Amount Incl ST</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="current_subtotal" t-value="0" />
                        <t t-set="qty_total" t-value="0" />
                        <t t-set="amount_total" t-value="0" />
                        <t t-set="tax_amount_total" t-value="0" />
                        <t t-set="st_amount_total" t-value="0" />
                        <t t-set="lines" t-value="doc.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)" />

                        <t t-foreach="doc.invoice_line_ids" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded" />
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included" />

                            <t t-set="qty_total" t-value="qty_total + line.quantity" />
                            <t t-set="amount_total" t-value="amount_total + line.price_subtotal" />
                            <t t-set="tax_amount_total" t-value="tax_amount_total + line.sh_tax_amount" />
                            <t t-set="st_amount_total" t-value="st_amount_total + line.sh_st_amount" />

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <!--                                Start Customization-->
                            <!--                                <t t-if="not line.display_type">-->
                            <!--                                End Customization-->
                                <t>
                                    <!-- <td name="td_code"><span t-field="line.product_id.default_code" /></td> -->
                                    <td name="td_name" class="text-left" style="font-size: 13px;"><span t-field="line.name" /></td>

                                    <td name="th_lot" class="text-left" style="font-size: 13px;">
                                        <span t-field="line.sh_lot_id" style="display: block;" />
                                        <t t-if="line.sh_lot_id.expiration_date">
                                            <span t-esc="line.sh_lot_id.expiration_date.strftime('%m/%Y')" style="display: block;" />
                                        </t>
                                    </td>
                                    <!-- <td name="th_exp_date" class="text-center"></td> -->

                                    <td name="td_quantity" class="text-center" style="font-size: 13px;">
                                        <span t-field="line.quantity" />
                                        <!-- <span t-field="line.product_uom_id" /> -->
                                    </td>

                                    <td name="td_weight" class="text-center" style="font-size: 13px;">
                                        <span t-esc="line.quantity * line.product_weight" />
                                        <!-- <span t-field="line.product_uom_id" /> -->
                                    </td>
                                    <td name="td_mrp" class="text-center" style="font-size: 13px;"><span t-esc="'%.2f'% line.sh_mrp" /></td>
                                    <td name="td_tp" class="text-center" style="font-size: 13px;"><span t-esc="'%.2f'% line.sh_tp" /></td>
                                    <td name="td_priceunit" class="text-center" style="font-size: 13px;">
                                        <span t-esc="'%.2f'% line.price_unit" />
                                    </td>
                                    <td t-if="display_discount" class="text-center" groups="product.group_discount_per_so_line" style="font-size: 13px;">
                                        <span t-field="line.discount" />
                                    </td>
                                    <td name="td_subtotal" class="text-center o_price_total" style="font-size: 13px;">
                                        <!--                                        Start Customization-->
<!--                                        <span t-esc="'%.2f'% line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded" />-->
                                        <span t-esc="'%.2f'% line.price_subtotal"/>
                                        <!--                                        End Customization-->
                                    </td>
                                    <td name="td_sh_st_rate" class="text-center" style="font-size: 13px;"><span t-esc="line.sh_st_rate" /></td>
                                    <td name="td_tax_amount" class="text-center" style="font-size: 13px;"><span t-esc="'%.2f'% line.sh_tax_amount" /></td>
                                    <td name="td_sh_incl_st" class="text-center" style="font-size: 13px;"><span t-esc="'%.2f'%line.sh_st_amount" /></td>
                                </t>
                            </tr>
                        </t>
                        <tr>
                            <t t-if="display_discount">
                                <td colspan="11" style="border-top: 0px; margin: 0px; padding: 0px;"><hr style="border-top: 2px solid #000; margin: 0px; padding: 0px;" /></td>
                            </t>
                            <t t-else="">
                                <td colspan="10" style="border-top: 0px; margin: 0px; padding: 0px;"><hr style="border-top: 2px solid #000; margin: 0px; padding: 0px;" /></td>
                            </t>
                        </tr>
                        <tr>
                            <td colspan="2"/>
                            <td name="td_qty_total" class="text-center" style="font-size: 13px;">
                                <strong><span t-esc="'%.2f'% qty_total" /></strong>
                            </td>
                            <td colspan="4" />
                            <t t-if="display_discount"><td style="border-top: 0px;" /></t>
                            <td name="td_amount_total" class="text-center" style="font-size: 13px;">
                                <strong><span t-esc="'%.2f'% amount_total" /></strong>
                            </td>
                            <td />
                            <td name="td_tax_amount_total" class="text-center" style="font-size: 13px;">
                                <strong><span t-esc="'%.2f'% tax_amount_total" /></strong>
                            </td>
                            <td name="td_st_amount_total" class="text-center" style="font-size: 13px;">
                                <strong><span t-esc="'%.2f'% st_amount_total" /></strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total" class="row">
                        <div class="col-5"></div>
                        <div class="col-7" style="padding-left: 23px;">
                            <table class="table table-sm" style="page-break-inside: avoid;">
                                <!--Tax totals-->
                                <t t-set="tax_totals" t-value="json.loads(json.dumps(doc.tax_totals))" />
                                <t t-call="account.document_tax_totals" />

                                <!--Payments-->
                                <t t-if="print_with_payments">
                                    <t t-if="doc.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals" t-value="doc.sudo()._get_reconciled_info_JSON_values()" />
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr>
                                                <td>
                                                    <i class="oe_form_field text-right oe_payment_label">Paid on <t t-esc="payment_vals['date']" t-options='{"widget": "date"}' /></i>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' />
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) > 0">
                                            <tr class="border-black">
                                                <td><strong>Amount Due</strong></td>
                                                <td class="text-right">
                                                    <span t-field="doc.amount_residual" />
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row" name="total">
                        <div t-attf-class="#{'col-5' if report_type != 'html' else 'col-sm-8 col-md-6'} ml-auto">
                            <table class="table table-sm">
                                <tr>
                                    <td class="text-right" style="border-top: 1px solid black;"><strong>Total Value Inclusive Sales Tax</strong></td>
                                    <td name="td_st_amount_total" style="border-top: 1px solid black;" class="text-right"><span t-esc="'%.2f'% st_amount_total" /></td>
                                </tr>
                                <tr>
                                    <td class="text-right"><strong>Advance Income Tax u/s 236H</strong></td>
                                    <td name="td_st_amount_total" class="text-right"><span t-esc="'%.2f'% st_amount_total" /></td>
                                </tr>
                                <tr>
                                    <td class="text-right" style="border-top: 1px solid black;"><strong>Grand Total</strong></td>
                                    <td name="td_st_amount_total" style="border-top: 1px solid black;" class="text-right"><span t-esc="'%.2f'% st_amount_total" /></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div> -->

				<div t-if="not is_html_empty(doc.narration)" name="comment">
                        <span t-field="doc.narration"/>
                </div>
                <div class="oe_structure" />
            </div>
        </t>
    </template>

        <template id="invoice_retailer_report_with_weight">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="invoice_retailer_with_weight_report.invoice_retailer_report_with_weight_template" t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>








            </t>
        </t>
    </template>
    <record id="city_books_ledger_report_paper" model="report.paperformat">
        <field name="name">Product Ledger Report (PDF)</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="city_books_ledger_report_action" model="ir.actions.report">
        <field name="name">Books Ledger Report (PDF)</field>
        <field name="model">city.books.ledger.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cityschool_books_sale_ledger_report.city_books_ledger_report_pdf_doc</field>
        <field name="report_file">cityschool_books_sale_ledger_report.city_books_ledger_report_pdf_doc</field>
        <field name="binding_model_id" ref="model_city_books_ledger_report"/>
        <field name="paperformat_id" ref="city_books_ledger_report_paper"/>
        <field name="binding_type">report</field>
    </record>


</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="city_books_ledger_report_pdf_doc">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="rec.get('category_dict').items()" t-as="category">
                        <div class="row">
                            <div class="col-8" align="left">
                                <h5>
                                    <b>
                                        Sale of&#160;
                                        <t t-esc="category[0]"/>&#160;(
                                        <span t-esc="rec.get('from_date')"/>&#160;
                                        to:&#160;
                                        <span t-esc="rec.get('to_date')"/>)
                                    </b>
                                </h5>
                            </div>
                            <div class="col-6" align="left"/>
                        </div>
                        <br/>
                        <table width="100%">
                            <thead>
                                <tr style="border: 1px solid black; background-color: #DCDCDC;">
                                    <th style="padding: 8px;border: 1px solid black;" width="20%">
                                        <span>Detail</span>
                                    </th>
                                    <th style="padding: 8px;border: 1px solid black;" width="10%">
                                        <span>Cost</span>
                                    </th>
                                    <th style="padding: 8px;border: 1px solid black;" width="10%">
                                        <span>Sale Price</span>
                                    </th>
                                    <th style="padding: 8px;border: 1px solid black;" width="20%">
                                        <span>Total Received</span>
                                    </th>
                                    <th style="padding: 8px;border: 1px solid black;" width="10%">
                                        <span>Sale</span>
                                    </th>
                                    <th style="border: 1px solid black;" width="10%">
                                        <span>Balance</span>
                                    </th>
                                    <th style="border: 1px solid black;" width="10%">
                                        <span>Amount</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Product Rows -->
                                <t t-foreach="category[1]" t-as="product">
                                    <tr style="border: 1px solid black;">
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('product')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('cost')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('sale_price')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('total_received')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('total_sold')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('balance_qty')"/>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid black;">
                                            <t t-esc="product.get('balance_qty') * product.get('sale_price')"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <br/>
                    </t>

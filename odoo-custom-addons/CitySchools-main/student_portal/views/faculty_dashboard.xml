<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="student_dashboard_template" name="Student Dashboard Template">
        <t t-call="web.layout">
            <head>
                <!--                <meta charset="UTF-8"/>-->
                <!--                <meta http-equiv="X-UA-Compatible" content="IE=edge"/>-->
                <!--                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>0-->
                <link rel="stylesheet" href="/student_portal/static/src/css/style.css"/>
                <link rel="stylesheet" href="/student_portal/static/src/css/responsive.css"/>
                <!-- font-awsome CDN Link -->
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
                      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
                      crossorigin="anonymous" referrerpolicy="no-referrer"/>
                <link rel='stylesheet'
                      href='https://cdn-uicons.flaticon.com/2.5.1/uicons-thin-rounded/css/uicons-thin-rounded.css'/>

            </head>

            <body>
                <header>
                    <div class="logosec">
                        <div class="menuicn">
                            <!-- <span> &#x2630;</span> -->
                            <i class="fa-solid fa-bars-staggered"></i>
                        </div>
                    </div>
                    <div class="message">
                        <!-- <span>&#128276;</span> -->
                        <i class="fa-regular fa-bell"></i>
                        <!-- <span id="fullscreen-toggle" onclick="toggleFullscreen()">&#x26F6;</span> -->
                        <i class="fa-solid fa-expand" id="fullscreen-toggle" onclick="toggleFullscreen()"></i>
                        <!-- <span id="theme-toggle">&#9789;</span> -->
                        <i class="fa-solid fa-circle-half-stroke" id="theme-toggle"></i>
                        <img class="nav-img profile_pic" t-att-src="image_data_uri(student.image_1920)" alt="Profile Pic"/>
                    </div>
                </header>
                <div class="main-container">
                    <div class="navcontainer">
                        <nav class="nav">
                            <div class="nav-upper-options">
                                <a href="/student_dashboard">
                                    <div class="nav-option">
                                        <!-- <i class="fi fi-tr-dashboard-panel nav-img"></i> -->
                                        <img class="nav-img" src="/student_portal/static/src/img/dashboard (2).png"
                                             alt="animated_icon"/>
                                        <h3>Dashboard</h3>
                                    </div>
                                </a>
                                <a href="/student_profile">
                                    <div class="option2 nav-option">
                                        <img class="nav-img" src="/student_portal/static/src/img/user.png"
                                             alt="profile"/>
                                        <h3>Profile</h3>
                                    </div>
                                </a>
                                <a href="/fee">
                                    <div class="nav-option option3">
                                        <img class="nav-img" src="/student_portal/static/src/img/calendar.png"
                                             alt="Fee"/>
                                        <h3>Fee</h3>
                                    </div>
                                </a>
                            </div>
                        </nav>
                    </div>

                    <div class="main">
                        <div class="box-container">
                            <div class="box student_box1">
                                <div class="profile-section" >
                                    <img id="user_img"
                                         t-att-src="'data:image/png;base64,' + student.image_1920.decode('utf-8')"
                                         alt="Profile Picture"/>
                                    <div class="profile-info">
                                        <h4 class="profile-name">
                                            <t t-esc="name"/>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                            <div class="box student_box2">
                                <div class="classes-section">
                                    <h6 class="classes-heading">Details :</h6>
                                    <div class="class-card">
                                        <strong class="class-subject">Year :</strong>
                                        <span class="class-details"><t t-esc="year"/></span>
                                    </div>
                                    <div class="class-card">
                                        <strong class="class-subject">Class :</strong>
                                        <span class="class-details">
                                        <t t-esc="class"/>
                                        </span>
                                    </div>
                                    <div class="class-card">
                                        <strong class="class-subject">Section :</strong>
                                        <span class="class-details">
                                        <t t-esc="section"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="slider_main">
                            <h3>Notifications :</h3>
                            <div class="slider-container">
                                <div class="arrow-left">&lt;</div>
                                <div class="slider-wrapper">
                                    <div class="slider">
                                        <t t-foreach="notify" t-as="nft">
                                            <div class="slide">
                                                <div class="innercard">
                                                    <img id="user_img_notif" t-att-src="image_data_uri(nft.image)"
                                                         alt="img"/>
                                                    <p>
                                                        <strong>Title:</strong>
                                                        <t t-esc="nft.name"/>
                                                    </p>
                                                    <p class="description">
                                                        <strong>Uploaded By:</strong>
                                                        <t t-esc="nft.uploaded_by.name"/>
                                                    </p>
                                                    <p>
                                                        <strong>Expiry Date:</strong>
                                                        <t t-esc="nft.expiry"/>
                                                    </p>
                                                    <button class="read-more-btn" style="display:none;">Read More
                                                    </button>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="arrow-right">&gt;</div>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="/student_portal/static/src/js/index.js"></script>
            </body>
        </t>
    </template>
</odoo>
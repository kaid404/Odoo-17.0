<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="security_refund_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .main{position:relative;font-size:15px;height:522px;width:760px;border-radius:0px;border:5px solid
                    silver;background-image:url("/security_refund_print/static/src/img/bg_img");background-repeat:no-repeat;background-size:100% 100%;background-position:
                    center;}
                    .main_inner{height:100%;width:100%;background-color:rgba(255, 255, 255,
                    .7);opacity:0.95;border-radius:0px;}
                    .inner_container{z-index:1000;height:100%;width:100%;background-color:transparent;opacity:1;border-radius:0px;}
                    .right_corner{z-index:-1;position:absolute;top:0;right:0;height:150px;}
                    .lft_corner{z-index:0;position:absolute;bottom:0px;left:0;height:150px;width:100%;}
                    .head{padding-top:35px;padding-bottom:30px;}
                    .logo{text-align:center;}
                    .head h5{font-size:25px;padding-left:70px;margin:0;}
                    .address{font-size:13px;padding-left:90px;}
                    .title{font-size:15px;padding-left:170px;}
                    .dynamic_data_lines{border-bottom:1px dotted;}
                    table{border:1px dotted silver;width:100%;}
                    table td ,th{border-bottom:1px dotted silver;padding:3px;text-align:center;}
                    <!--                                        table,right_corner,lft_corner,head,row{z-index:20000;color:black;opacity:1;}-->
                </style>
                <t t-foreach="docs" t-as="o">
                    <div class="main">
                        <!--                            <img class="lft_corner" src="/security_refund_print/static/src/img/bg9.png"/>-->
                        <div class="main_inner">
                            <!--                            <img class="right_corner" src="/security_refund_print/static/src/img/bg8_right.png"/>-->
                            <div class="inner_container">
                                <div class="head">
                                    <div class="row">
                                        <div class="logo col-2">
                                            <!--                                            <img t-if="o.company_id.logo"-->
                                            <!--                                                 t-att-src="'data:image/png;base64,%s' % o.company_id.logo.decode('utf-8')"-->
                                            <!--                                                 alt="Company Logo" style="max-height: 80px;"/>-->
                                            <img src="/security_refund_print/static/src/img/logo.png" alt="Company Logo"
                                                 style="max-height: 80px;"/>
                                        </div>
                                        <div class="col-10">
                                            <h5>
                                                <strong>CITY HIGH SCHOOL (
                                                    <t t-esc="o.company_id.name"/>
                                                    )
                                                </strong>
                                            </h5>
                                            <div class="address">
                                                <span t-esc="o.company_id.street"/>
                                                <span t-esc="o.company_id.street2"/>
                                                <span t-esc="o.company_id.city"/>
                                                <!--                                    </div>-->
                                                <!--                                    <div>-->
                                                <t t-if="o.company_id.state_id.name or o.company_id.country_id.name or o.company_id.phone">
                                                    ,
                                                </t>
                                                <span t-esc="o.company_id.state_id.name"/>
                                                <span t-esc="o.company_id.country_id.name"/>
                                                <span t-esc="o.company_id.phone"/>
                                                .
                                            </div>
                                            <div class="title">
                                                <strong>SECURITY REFUND VOUCHER</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-3">
                                        <span>Student ID &#160;&#160;&#160;:
                                        </span>
                                    </div>
                                    <div class="col-3 dynamic_data_lines">
                                        <strong t-if="o.student_id.gr_no">
                                            <t t-esc="o.student_id.gr_no"/>
                                        </strong>
                                    </div>
                                    <div class="col-3">
                                        <span>Received Date &#160;&#160;&#160;:</span>
                                    </div>
                                    <div class="col-3 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.get_write_date_Refund()"/>
                                        </strong>

                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-3">Security Refunded to &#160;&#160;&#160;:</div>
                                    <div class="col-9 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.student_id.name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-3">Son / Daughter of Mr. &#160;&#160;&#160;:</div>
                                    <div class="col-9 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.student_id.father_name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-4">Was admitted to this school on &#160;&#160;&#160;:</div>
                                    <div class="col-2 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.get_create_date_std()"/>
                                        </strong>
                                    </div>
                                    <div class="col-2">
                                        and left on &#160;&#160;&#160;:
                                    </div>
                                    <div class="col-2 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.get_write_date_Refund()"/>
                                        </strong>
                                    </div>
                                    <div class="col-1">
                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-4">He / She was studying in class &#160;&#160;&#160;:</div>
                                    <div class="col-2 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.class_id.name"/>
                                        </strong>
                                    </div>
                                    <div class="col-2">
                                        Campus &#160;&#160;&#160;:
                                    </div>
                                    <div class="col-2 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.student_id.company_id.name"/>
                                        </strong>
                                    </div>
                                    <div class="col-1">
                                    </div>
                                </div>
                                <div class="row py-2 px-4">
                                    <div class="col-3">
                                        Security Amount &#160;&#160;&#160;:
                                    </div>
                                    <div class="col-3 dynamic_data_lines">
                                        <strong>
                                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                                <t t-if="line.product_id.name == 'security_fee'">
                                                    <t t-esc="line.price_unit"/>
                                                </t>
                                            </t>
                                        </strong>
                                    </div>
                                    <div class="col-3">
                                        Security Received by &#160;&#160;&#160;:
                                    </div>
                                    <div class="col-3 dynamic_data_lines">
                                        <strong>
                                            <t t-esc="o.security_received_by"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="security_refund_template_paper_format" model="report.paperformat">
        <field name="name">Security Refund Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="report_security_refund_print_detail" model="ir.actions.report">
        <field name="name">Security Refund</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">security_refund_print.security_refund_template</field>
        <field name="report_file">security_refund_print.security_refund_template</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="security_refund_print.security_refund_template_paper_format"/>
    </record>
</odoo>

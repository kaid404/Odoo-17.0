<odoo>
    <record id="view_op_student_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header>
                <field name="is_fee_invoice" invisible="1"/>
                <button name="%(fee_voucher.fee_voucher_print_action)d" string="Print Fee Voucher" type="action" class="btn-primary" invisible="payment_state != 'not_paid' or is_fee_invoice != True or company_id not in [6,7,8]"/>
<!--                <field name="payment_create_date" invisible="1"/>-->
<!--                <field name="payment_create_user" invisible="1"/>-->
            </header>
        </field>
    </record>
</odoo>

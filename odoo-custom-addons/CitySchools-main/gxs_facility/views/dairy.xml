<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_op_subject_dairy_tree" model="ir.ui.view">
            <field name="name">op.subject.dairy.tree</field>
            <field name="model">op.subject.dairy</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Facility">
                    <field name="faculty_id"/>
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="date"/>
                    <field name="comment"/>
                </tree>
            </field>
        </record>


        <record model="ir.actions.act_window" id="act_open_op_subject_dairy_view">
            <field name="name">Dairy</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.subject.dairy</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">tree</field>
            <field name="search_view_id" ref="view_op_subject_dairy_tree"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>


<!--        <record model="ir.actions.act_window.view" id="act_open_op_subject_dairy_view_tree">-->
<!--            <field name="act_window_id" ref="act_open_op_subject_dairy_view"/>-->

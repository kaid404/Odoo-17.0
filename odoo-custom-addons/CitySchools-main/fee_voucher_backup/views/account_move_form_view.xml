<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="fee_voucher_template_old">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .main{position:relative;font-size:12px;height:522px;width:760px;border-radius:0px;border:2px solid
                    silver;background-image:url("/city_school/static/src/img/bg_img.png");background-repeat:no-repeat;background-size:100%
                    100%;background-position:
                    center;}
                    .main_inner{height:100%;width:100%;background-color:rgba(255, 255, 255,
                    .6);opacity:0.95;border-radius:0px;}
                    .inner_container{z-index:1000;height:100%;width:100%;background-color:transparent;opacity:1;border-radius:0px;}
                    .right_corner{z-index:-1;position:absolute;top:0;right:0;height:150px;}
                    .lft_corner{z-index:0;position:absolute;bottom:0px;left:0;height:250px;width:100%;}
                    .head{padding-top:25px;text-align:center;}
                    .logo{text-align:center;}
                    .head h5{font-size:25px;margin:0;}
                    .address{font-size:13px;}
                    .title{font-size:15px;}
                    .dynamic_data_lines{border-bottom:0px dotted;margin-bottom:3px;}
                    table{border:1px dotted silver;width:100%;}
                    table td ,th{border-bottom:1px dotted silver;padding:3px;text-align:center;}
                    <!--                                        table,right_corner,lft_corner,head,row{z-index:20000;color:black;opacity:1;}-->
                </style>
                <t t-foreach="docs" t-as="o">
                    <t t-set="o" t-value="o.sudo()"/>
                    <div class="main">
                        <!--                        <img class="lft_corner" src="/city_school/static/src/img/bg9.png"/>-->
                        <div class="main_inner">
                            <!--                            <img class="right_corner" src="/city_school/static/src/img/bg8_right.png"/>-->
                            <div class="inner_container">
                                <div class="head">
                                    <div class="row">
                                        <div class="logo col-2">
                                            <!--                                            <img t-if="o.company_id.logo"-->
                                            <!--                                                 t-att-src="'data:image/png;base64,%s' % o.company_id.logo.decode('utf-8')"-->
                                            <!--                                                 alt="Company Logo" style="max-height: 80px;"/>-->
                                            <img src="/city_school/static/src/img/logo.png" alt="Company Logo"
                                                 style="max-height: 80px;"/>
                                        </div>
                                        <div class="col-8">
                                            <h5>
                                                <strong>CITY HIGH SCHOOL (
                                                    <t t-esc="o.company_id.name"/>
                                                    )
                                                </strong>
                                            </h5>
                                            <div class="address">
                                                <span t-esc="o.company_id.street"/>
                                                <span t-esc="o.company_id.street2"/>
                                                <span t-esc="o.company_id.city"/>
                                                <!--                                    </div>-->
                                                <!--                                    <div>-->
                                                <t t-if="o.company_id.state_id.name or o.company_id.country_id.name or o.company_id.phone">
                                                    ,
                                                </t>
                                                <span t-esc="o.company_id.state_id.name"/>
                                                <span t-esc="o.company_id.country_id.name"/>
                                                <span t-esc="o.company_id.phone"/>
                                                .
                                            </div>
                                            <div class="title">
                                                <strong>FEE VOUCHER</strong>
                                            </div>
                                        </div>
                                        <div class="col-2 logo">
                                            <img src="/city_school/static/src/img/image.png"
                                                 alt="https://www.cityhighschool.pk" height="80px"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row px-4">
                                    <div class="col-7"></div>
                                    <div class="col-5 pt-2" style="text-align:right;">
                                        <strong>PARENT COPY</strong>
                                    </div>
                                </div>
                                <div class="row px-4">
                                    <div class="col-2 ps-2">
<!--                                        <div style="margin-bottom:2px;height:25px;">-->
<!--                                            &lt;!&ndash;                                    <span>Serial No :</span>&ndash;&gt;-->

<!--                                        </div>-->
                                        <div class="dynamic_data_lines">
                                            <span>Invoice No :</span>

                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>Month :</span>

                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>Class :</span>

                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>Roll No :</span>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>Student Name :</span>

                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>Father Name :</span>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>
                                                Mobile :
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-5 text-left">
<!--                                        <div style="margin-bottom:2px;text-align:center;font-size:20px;">-->
<!--                                            <strong t-if="o.company_id.name">-->
<!--                                                <t t-esc="o.company_id.name"/>-->
<!--                                            </strong>-->
<!--                                            <strong t-else="">-->
<!--                                                &#160;&#160;&#160;&#160;&#160;-->
<!--                                            </strong>-->

<!--                                        </div>-->
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.name">
                                                <t t-esc="o.name"/>
                                            </strong>
                                            <strong t-else="">
                                                &#160;&#160;&#160;&#160;&#160;
                                            </strong>

                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong>
                                                <t t-esc="o.get_current_month_formatted()"/>
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.student_id.year_id.name">
                                                <t t-esc="o.student_id.year_id.name"/> (<t t-esc="o.student_id.section_id.name"/>)
                                            </strong>
                                            <strong t-else="">
                                                &#160;&#160;&#160;&#160;&#160;
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.student_id.gr_no">
                                                <t t-esc="o.student_id.gr_no"/>
                                            </strong>
                                            <strong t-else="">
                                                &#160;&#160;&#160;&#160;&#160;
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.student_id.name">
                                                <t t-esc="o.student_id.name"/>
                                            </strong>
                                            <strong t-else="">
                                                &#160;&#160;&#160;&#160;&#160;
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.student_id.father_name">
                                                <t t-esc="o.student_id.father_name"/>
                                            </strong>
                                            <strong t-else="">
                                                &#160;&#160;&#160;&#160;&#160;
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong t-if="o.mobile">
                                                <t t-esc="o.mobile"/>
                                                <!--                                        &#160;&#160;&#160;&#160;&#160;-->
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <table>
                                            <tr>
                                                <th colspan="2"
                                                    style="background-color:#026ab2;color:white;text-align:center;padding:5px;">
                                                    FEE CHALAN
                                                </th>
                                            </tr>
                                            <t t-foreach="o.invoice_line_ids" t-as="fee">
                                                <t t-if="fee.price_unit >= 0">
                                                    <tr>
                                                        <th>
                                                            <t t-esc="fee.product_id.name"/>
                                                        </th>
                                                        <td>
                                                            <t t-esc="round(fee.price_unit)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                            <tr>
                                                <th>
                                                    Payable By :
                                                    <t t-esc="o.invoice_date_due"/>
                                                </th>
                                                <td>
                                                    <t t-set="balance"
                                                       t-value="sum(line.price_unit for line in o.invoice_line_ids)"/>
                                                    <t t-esc="round(balance)"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>
                                                    Payable After Due Date :
                                                </th>
                                                <td>
                                                    <t t-set="balance"
                                                       t-value="sum(line.price_unit for line in o.invoice_line_ids)"/>
                                                    <t t-esc="round(balance +  o.get_fine_amount_year_base())"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div style="font-size:11px;" class="row px-4">
                                    <div class="col-7 pe-1">
                                        <div class="dynamic_data_lines">
                                            <span>
                                                1- Tuition Fee should be payable in advance on One month basis and once
                                                paid is
                                                NON-REFUNDABLE.
                                            </span>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>
                                                2- Tuition Fee must be paid before the last date of payment stated on
                                                the Fee
                                                Bill.A Fine of Rs. <t t-esc="o.get_fine_amount_year_base()"/>/- will be charged after the lapse of due date.
                                            </span>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <strong>
                                                3- If a student fails to pay tuition fee within seven days after the
                                                last date
                                                of payment, he/she will not be permitted to sit in class.
                                            </strong>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span>
                                                4- If a student is to be withdrawn, a notice of one month must be given
                                                in
                                                writing or month's fee is payable in lieu of notice.
                                            </span>
                                        </div>
                                        <div class="dynamic_data_lines">
                                            <span style="border-bottom:1px solid;padding-bottom:3px;">
                                                Office will remain open on every Saturday
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <table style="border:none;">
                                            <tr>
                                                <th colspan="2"
                                                    style="background-color:#026ab2;color:white;text-align:center;">
                                                    Kindly Bring This Challan For Fee Deposit
                                                </th>
                                            </tr>
                                            <tr>
                                                <th style="border:none;border-bottom:1px dotted black;text-align:left;"
                                                    colspan="2">
                                                    <p>
                                                        Dear Parents,
                                                        <br/>
                                                        please note carefully that <i>"LATE FEE DEPOSIT FINE"</i> wil
                                                        not be remitted after due date Now to onwards.
                                                        <br/>
                                                        Thanks
                                                    </p>
                                                </th>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="row px-4">
                                    <div class="col-3 pt-4">
                                        <span>Issue Date :</span>
                                        <strong>
                                            <t t-esc="o.invoice_date"/>
                                        </strong>
                                    </div>
                                    <div class="col-3 pt-4">
                                        <span>Due Date :</span>
                                        <strong>
                                            <t t-esc="o.invoice_date_due"/>
                                        </strong>
                                    </div>
                                    <div class="col-3 pt-4">
                                        <span style="border-top:1px solid;padding:5px;">Account Officer</span>
                                    </div>
                                     <div class="col-1 pt-1 pe-1" style="margin-top:-40px;text-align:right;">
                                        <img src="/city_school/static/src/img/www.png"
                                             alt="https://www.cityhighschool.pk" width="17px" class="pb-1"/>
                                        <br/>
                                        <img src="/city_school/static/src/img/Instagram_icon.png"
                                             alt="https://www.instagram.com/cityhighschoolfsd_/?hl=en" width="17px"
                                             class="pb-1"/>
                                        <br/>

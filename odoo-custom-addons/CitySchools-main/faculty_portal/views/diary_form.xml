<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="diary_form_template" name="Faculty Dashboard Template">
        <t t-call="web.layout">
            <head>
                <link rel="stylesheet" href="/faculty_portal/static/src/css/style.css"/>
                <link rel="stylesheet" href="/faculty_portal/static/src/css/responsive.css"/>
                <!-- font-awsome CDN Link -->
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
                      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
                      crossorigin="anonymous" referrerpolicy="no-referrer"/>
                <link rel='stylesheet'
                      href='https://cdn-uicons.flaticon.com/2.5.1/uicons-thin-rounded/css/uicons-thin-rounded.css'/>
                <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            </head>

            <body>
                <header>
                    <div class="logosec">
                        <div class="menuicn">
                            <!-- <span> &#x2630;</span> -->
                            <i class="fa-solid fa-bars-staggered"></i>
                        </div>
                    </div>

                    <div class="message">
                        <!-- <span>&#128276;</span> -->
                        <i class="fa-regular fa-bell"></i>
                        <!-- <span id="fullscreen-toggle" onclick="toggleFullscreen()">&#x26F6;</span> -->
                        <i class="fa-solid fa-expand" id="fullscreen-toggle" onclick="toggleFullscreen()"></i>
                        <!-- <span id="theme-toggle">&#9789;</span> -->
                        <i class="fa-solid fa-circle-half-stroke" id="theme-toggle"></i>
                        <!--                        <img class="nav-img profile_pic" t-att-src="image_data_uri(faculty_staff.image_1920)" alt="Profile Pic"/>-->
                    </div>
                </header>

                <div class="main-container">
                    <div class="navcontainer">
                        <nav class="nav">
                            <div class="nav-upper-options">
                                <a href="/dashboard">
                                    <div class="nav-option">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/dashboard (2).png"
                                             alt="animated_icon"/>
                                        <h3>Dashboard</h3>
                                    </div>
                                </a>
                                <a href="/profile">
                                    <div class="option2 nav-option">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/user.png"
                                             alt="profile"/>
                                        <h3>Profile</h3>
                                    </div>
                                </a>
                                <a href="/attendance">
                                    <div class="nav-option option3">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/calendar.png"
                                             alt="Attendance"/>
                                        <h3>Attendance</h3>
                                    </div>
                                </a>
                                <a href="/diary_form">
                                    <div class="nav-option option3">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/calendar.png"
                                             alt="Attendance"/>
                                        <h3>Diary</h3>
                                    </div>
                                </a>
                                <a href="/notification">
                                    <div class="nav-option option6">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/box.png"
                                             alt="Notifications"/>
                                        <h3>Notifications</h3>
                                    </div>
                                </a>
                            </div>
                        </nav>
                    </div>


                    <mian class="main">
                        <a href="/diary">
                            <button class="create_diary_btn">Create Diary
                                <i class="fa-solid fa-arrow-right btn_arow"></i>
                            </button>
                        </a>
                        <table class="create_diary_table">
                            <thead>
                                <tr>
                                    <th>Diary Name</th>
                                    <th>Date</th>
                                    <th>Records</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="diary_rec" t-as="line">
                                    <!-- Main row for diary -->
                                    <tr class="diary-row" t-att-data-line-id="line.id">
                                        <td>
                                            <t t-esc="line.name"/>
                                        </td>

                                        <td>
                                            <t t-esc="line.create_date.date()"/>
                                        </td>
                                        <td>
                                            <!-- Button to toggle diary lines -->
                                            <button type="button" class="expand-btn" t-att-data-line-id="line.id">View
                                                Lines
                                            </button>
                                        </td>
                                    </tr>
                                    <!-- Expandable section for diary lines, initially hidden -->
                                    <tr class="diary-lines-row" t-att-data-line-id="line.id" style="display:none;">
                                        <td colspan="3">
                                            <table class="inner_table">
                                                <thead class="inner_table_head">
                                                    <tr>
                                                        <th>Subject</th>
                                                        <th>Class</th>
                                                        <th>Description</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="line.diary_line_ids" t-as="diary_line">
                                                        <tr>
                                                            <td>
                                                                <t t-esc="diary_line.subject"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="diary_line.class_id"/>
                                                            </td>
                                                            <td>
                                                                <t t-esc="diary_line.description"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                            // Get all the expand buttons
                            const expandButtons = document.querySelectorAll('.expand-btn');

                            expandButtons.forEach(function(button) {
                            button.addEventListener('click', function() {
                            const lineId = button.getAttribute('data-line-id');

                            // Hide all other diary lines
                            const allLinesRows = document.querySelectorAll('.diary-lines-row');
                            allLinesRows.forEach(function(row) {
                            row.style.display = 'none';
                            });

                            // Toggle the display of the specific lines row for this button
                            const linesRow = document.querySelector('.diary-lines-row[data-line-id="' + lineId + '"]');
                            if (linesRow) {
                            linesRow.style.display = (linesRow.style.display === 'none') ? 'table-row' : 'none';
                            }
                            });
                            });
                            });

                        </script>
                    </mian>
                </div>
                <script src="/faculty_portal/static/src/js/index.js"></script>
            </body>
        </t>
    </template>
</odoo>
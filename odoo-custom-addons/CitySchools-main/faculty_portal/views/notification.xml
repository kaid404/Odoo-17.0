<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="notification_template" name="Faculty Dashboard Template">
        <t t-call="web.layout">
            <head>
                <!--                <meta charset="UTF-8" />-->
                <!--                <meta http-equiv="X-UA-Compatible" content="IE=edge" />-->
                <!--                <meta name="viewport" content="width=device-width, initial-scale=1.0" />-->
                <link rel="stylesheet" href="/faculty_portal/static/src/css/style.css"/>
                <link rel="stylesheet" href="/faculty_portal/static/src/css/responsive.css"/>
                <!-- font-awsome CDN Link -->
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
                      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
                      crossorigin="anonymous" referrerpolicy="no-referrer"/>
                <link rel='stylesheet'
                      href='https://cdn-uicons.flaticon.com/2.5.1/uicons-thin-rounded/css/uicons-thin-rounded.css'/>
            </head>

            <body>

                <header>
                    <div class="logosec">
                        <!--                        <img-->
                        <!--                            src="/faculty_portal/static/src/img/static/src/img/png-transparent-hamburger-button-computer-icons-menu-bar-line-thumbnail.png"-->
                        <!--                            class="icn menuicn" id="menuicn" alt="menu-icon" />-->
                        <div class="menuicn">
                            <span> &#x2630;</span>
                        </div>
                    </div>
                    <div class="message">
                        <li class="dropdown">
                                    <a href="#" onClick="return false;" class="dropdown-toggle"
                                       data-bs-toggle="dropdown"
                                       role="button">
                                        <i class="far fa-bell"></i>
                                        <span class="notify"></span>
                                        <span class="heartbeat"></span>
                                    </a>


                        </li>


                          <i class="fa-solid fa-expand" id="fullscreen-toggle" onclick="toggleFullscreen()"></i>
                        <!-- <span id="theme-toggle">&#9789;</span> -->
                        <i class="fa-solid fa-circle-half-stroke" id="theme-toggle"></i>
                        <img class="nav-img" src="/faculty_portal/static/src/img/man.png" alt="Profile Pic"/>
                    </div>
                </header>

                <div class="main-container">
                    <div class="navcontainer">
                        <nav class="nav">
                            <div class="nav-upper-options">
                                <a href="/dashboard">
                                    <div class="nav-option">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/dashboard (2).png"
                                             alt="animated_icon"/>
                                        <h3>Dashboard</h3>
                                    </div>
                                </a>
                                <a href="/profile">
                                    <div class="option2 nav-option">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/user.png"
                                             alt="profile"/>
                                        <h3>Profile</h3>
                                    </div>
                                </a>
                                <a href="/attendance">
                                    <div class="nav-option option3">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/calendar.png"
                                             alt="Attendance"/>
                                        <h3>Attendance</h3>
                                    </div>
                                </a>
                           <a href="/diary_form">
                                    <div class="nav-option option3">
                                        <img class="nav-img" src="/faculty_portal/static/src/img/calendar.png"
                                             alt="Attendance"/>
                                        <h3>Diary</h3>
                                    </div>
                                </a>
                                <a href="/notification">
                                <div class="nav-option option6">
                                    <img class="nav-img" src="/faculty_portal/static/src/img/box.png"
                                         alt="Notifications"/>
                                    <h3>Notifications</h3>
                                </div>
                                </a>
                            </div>
                        </nav>
                    </div>
                    <div class="main">
                        <div>
                                <div class="body table-responsive">
                                    <table id="" class="uk-table uk-table-nowrap table_check">
                                        <thead class="md-bg-blue-grey-700 ">
                                            <tr>
                                                <th class="uk-width-1-10 md-color-grey-50 ">Tittle</th>
                                                <th class="uk-width-1-10 md-color-grey-50 ">
                                                    Date
                                                </th>
                                                <th class="uk-width-1-10  md-color-grey-50 ">
                                                    Description
                                                </th>

                                                <th class="uk-width-1-10  md-color-grey-50 ">
                                                    Attachments
                                                </th>


                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="notify" t-as="Pro">

                                                <tr>

                                                    <td>
                                                        <t t-esc="Pro.name"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="Pro.date"/>
                                                    </td>

                                                    <td>
                                                        <t t-esc="Pro.remove_html_tags()"/>
                                                    </td>

                                                    <td>

                                                        <span>
<!--                                                            <a-->
<!--                                                                    t-attf-href="/web/content/#{Pro.sudo().attachment_id.id}?download=true"-->
<!--                                                                    target="_blank">-->

                                                                <a t-attf-href="/web/content/#{Pro.sudo().attachment_id.id}?download=true" target="_blank">
                                                                <div
                                                                        t-att-title="Pro.sudo().attachment_id.datas"
                                                                        t-att-data-mimetype="Pro.sudo().attachment_id.mimetype"
                                                                        t-attf-data-src="/web/image/#{Pro.sudo().attachment_id.id}/100x80"/>
                                                                <div
                                                                >
                                                                    <t
                                                                            t-raw='Pro.sudo().attachment_id.name'/>
                                                                </div>
                                                            </a>
                                                        </span>
                                                    </td>

                                                </tr>

                                            </t>
                                        </tbody>
                                    </table>

                                </div>

                        </div>
                    </div>

                </div>

                <script src="/faculty_portal/static/src/js/index.js"></script>
            </body>
        </t>
    </template>
</odoo>
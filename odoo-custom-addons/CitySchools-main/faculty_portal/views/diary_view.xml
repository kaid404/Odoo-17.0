<odoo>
        <!-- Tree View for Diary -->
        <record id="view_faculty_diary_tree" model="ir.ui.view">
            <field name="name">faculty.diary.tree</field>
            <field name="model">faculty.diary</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="diary_line_ids"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Diary -->
        <record id="view_faculty_diary_form" model="ir.ui.view">
            <field name="name">faculty.diary.form</field>
            <field name="model">faculty.diary</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="diary_line_ids">
                                <tree>
                                    <field name="subject"/>
                                    <field name="class_id"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Diary -->
        <record id="action_faculty_diary" model="ir.actions.act_window">
            <field name="name">Diary</field>
            <field name="res_model">faculty.diary</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new diary.
                </p>
            </field>
        </record>

        <!--              parent="gxs_core.menu_op_school_root"-->
        <menuitem id="menu_faculty_diary"
                  name="Diary"
                  action="action_faculty_diary"
                  sequence="10"
                  web_icon="faculty_portal,static/description/icon.png"/>
</odoo>

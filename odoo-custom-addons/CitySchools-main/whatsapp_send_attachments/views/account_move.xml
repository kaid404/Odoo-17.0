<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_model_fee_voucher" model="ir.cron">
            <field name="name">Automate send voucher</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.send_voucher_whatsapp_message()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
            <field eval="False" name="active"/>

        </record>

    <record id="ir_cron_model_fee_receipt" model="ir.cron">
            <field name="name">Automate send receipt</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.send_receipt_whatsapp_message()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
            <field eval="False" name="active"/>
        </record>



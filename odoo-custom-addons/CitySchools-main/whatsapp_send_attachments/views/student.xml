<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="student_attendance_form">
            <field name="name">student.whatsapp.massage</field>
            <field name="model">student.whatsapp.massage</field>
            <field name="arch" type="xml">
                <form string="Student Attendance Report">
                    <group col="4" colspan="4">
                        <field name="payload"/>
                        <field name="img"/>
                    </group>
                    <footer>
                        <span>
                            <button string="Send" type="object" name="action_share" class="oe_highlight"/>
                            <button special="cancel" string="Close" type="object"/>
                        </span>
                    </footer>
                </form>
            </field>
        </record>

        <record id="op_student_attendance_act" model="ir.actions.act_window">
            <field name="name">Whatsapp Message</field>
            <field name="res_model">student.whatsapp.massage</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="gxs_core.model_op_student"/>
        </record>

    </data>
</odoo>

    <record id="prospectus_paper_format" model="report.paperformat">
        <field name="name">Prospectus Receipt Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A5</field>
        <!--        <field name="height">148</field>-->
        <!--        <field name="width">210</field>-->
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="city_school_prospectus_reciept_action" model="ir.actions.report">
        <field name="name">Prospectus Receipt</field>
        <field name="model">op.admission</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">city_school_prospectus_reciept.high_school_prospectus_reciept</field>
        <field name="report_file">city_school_prospectus_reciept.high_school_prospectus_reciept</field>
        <field name="binding_model_id" ref="gxs_admission.model_op_admission"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="city_school_prospectus_reciept.prospectus_paper_format"/>
    </record>

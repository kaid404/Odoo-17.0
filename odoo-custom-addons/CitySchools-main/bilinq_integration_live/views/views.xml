    <record id="ir_cron_model_op_student" model="ir.cron">
            <field name="name">Sync To blinq</field>
            <field name="model_id" ref="gxs_core.model_op_student"/>
            <field name="state">code</field>
            <field name="code">model.sync_to_blinq_in_bulk()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field eval="False" name="doall"/>
            <field name="priority">1000</field>
        </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gxs_split_invoice_form" model="ir.ui.view">
            <field name="name">gxs.split.invoice.form</field>
            <field name="model">gxs.split.invoice</field>
            <field name="arch" type="xml">
                <form string="Invoice Installments">
                    <sheet>
                        <group>
                            <group>
                                <field name="invoice_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="installments"/>
                                <field name="installment_amount" readonly="0"/>
                                <field name="installment_amount" invisible="1"/>
                            </group>
                        </group>

                    </sheet>
                    <footer>
                        <button name="create_invoices" string="Make Installments" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="gxs_split_invoice">
            <field name="name">Receipt Installments</field>
            <field name="res_model">gxs.split.invoice</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="target">new</field>
        </record>



        <!--        <act_window-->
<!--                id="gxs_split_invoice"-->
<!--                name="Receipt Installments"-->
<!--                binding_model="account.move"-->
<!--                res_model="gxs.split.invoice"-->
<!--                binding_views="list,form" view_mode="form" target="new"/>-->

    </data>
</odoo>

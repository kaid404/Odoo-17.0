<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="fee_account_move_split_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference'] " position="before">
                <field name="child_move_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id'] " position="after">
                <field name="installment_no" readonly="1"/>
                <field name="installment_no" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box'] " position="inside">
                <button name="open_child_move_ids" class="btn oe_stat_button" icon="fa-pencil-square-o" type="object">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Installments</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>
</odoo>
<odoo>
    <record id="view_fee_report_wizard_form" model="ir.ui.view">
        <field name="name">fee.report.wizard.form</field>
        <field name="model">fee.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Fee Report Wizard">
                <group>
                    <field name="date" readonly="0"/>
                </group>
                <footer>
                    <button string="Print" type="object" name="print_report" class="btn-primary"/>
                    <button string="Cancel" type="object" name="cancel_action" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fee_report_wizard" model="ir.actions.act_window">
        <field name="name">Fee Report</field>
        <field name="res_model">fee.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fee_report_wizard_form"/>
        <field name="target">new</field>
    </record>

<!--    <menuitem id="menu_school_fee" name="School Fee" sequence="1"/>-->
    <menuitem id="menu_fee_report" name="Fee Report" parent="gxs_school_fee.menu_school_fee_form" action="action_fee_report_wizard"/>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fee_discount_tree" model="ir.ui.view">
        <field name="name">fee.discount.tree</field>
        <field name="model">fee.discount</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="student_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="fee_discount_form" model="ir.ui.view">
        <field name="name">fee.discount.form</field>
        <field name="model">fee.discount</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight mt-3"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'" class="mt-3"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <h3>
                        <field name="name"/>
                    </h3>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="move_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="discount_amount" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason_discount" readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>

        </field>
    </record>
    <record model="ir.actions.act_window" id="action_fee_discount_form">
        <field name="name">Fee Discount</field>
        <field name="res_model">fee.discount</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Fee Discount</p>
        </field>
    </record>


    <menuitem name="Fee Discount"
              id="menu_fee_discount_form"
              parent="gxs_school_fee.menu_generate_monthly_invoices_1"
              action="action_fee_discount_form"
              sequence="51"/>
</odoo>
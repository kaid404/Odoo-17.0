<odoo>
    <data>
        <record id="email_template_app_shortlisted" model="mail.template">
            <field name="name">Application Shortlisted</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="email_from">{{ user.company_id.email }}</field>
            <field name="email_to">{{ object.email_from or '' }}</field>
            <field name="subject">Application Shortlisted – {{ object.job_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="object.partner_name or ''"/>,
                    </p>
                    <p>
                        Your application for <b><t t-out="object.job_id.name or ''"/></b> at <b><t t-out="object.company_id.name or ''"/></b> has been shortlisted.
                    </p>
                    <p>
                        Our team will contact you shortly with next steps.
                    </p>
                    <p>
                        Best regards,<br/><t t-out="object.company_id.name or ''"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>

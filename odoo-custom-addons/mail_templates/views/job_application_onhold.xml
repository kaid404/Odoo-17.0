<odoo>
    <data>
        <record id="email_template_job_on_hold" model="mail.template">
            <field name="name">Job Application On-Hold</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="email_from">{{ user.company_id.email }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="subject">Application on-hold for future opportunities – {{ object.job_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>
                        Dear <t t-out="object.partner_name or ''"/>,
                    </p>
                    <p>
                        Thank you for applying for the position of
                        <b>
                            <t t-out="object.job_id.name or 'Job Title'"/>
                        </b>
                        at
                        <b>
                            <t t-out="object.company_id.name"/>
                        </b>
                        .
                        After reviewing your profile, we believe you have strong potential; however, at this time we are
                        keeping your application <b>on hold</b> as we currently do not have a suitable opening that
                        matches your skills and experience.
                    </p>

                    <p>
                        We will retain your application in our database and reach out to you when a relevant opportunity
                        becomes available in the future.
                    </p>

                    <p>
                        We truly appreciate your interest in joining
                        <b>
                            <t t-out="object.company_id.name"/>
                        </b>
                        and wish you success in your career journey.
                    </p>

                    <p>
                        <b>Best regards,</b>
                        <br/>
                        <t t-out="user.name"/>
                        <br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>

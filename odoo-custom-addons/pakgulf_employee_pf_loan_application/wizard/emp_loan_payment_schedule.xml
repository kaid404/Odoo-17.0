<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emp_loan_payment_schedule_wizard_form" model="ir.ui.view">
        <field name="name">emp.loan.payment.schedule.wizard</field>
        <field name="model">emp.loan.payment.schedule</field>
        <field name="arch" type="xml">
            <form string="Final Settlement Form">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                        <field name="loan_type"/>
                        <field name="loan_ids" widget="many2many_tags"
                               domain="[('loan_type','=',loan_type)]"/>
                    </group>
                </group>
                <footer>
                    <button name="loan_payment_schedule_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-danger" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="emp_loan_payment_schedule_action_window" model="ir.actions.act_window">
        <field name="name">Employee Loan Payment Schedule</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">emp.loan.payment.schedule</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="emp_loan_payment_schedule_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="emp_loan_payment_schedule_menu"
              name="Employee Loan Payment Schedule"
              parent="hr_payroll.menu_hr_payroll_report"
              action="emp_loan_payment_schedule_action_window"
              sequence="122"/>

</odoo>

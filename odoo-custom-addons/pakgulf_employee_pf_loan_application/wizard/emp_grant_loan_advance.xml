<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emp_grant_loan_application_wizard_form" model="ir.ui.view">
        <field name="name">pak.emp.grant.loan.application.wizard</field>
        <field name="model">pak.emp.grant.loan.application</field>
        <field name="arch" type="xml">
            <form string="Final Settlement Form">
                <group>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="grant_loan_application_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-danger" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="emp_grant_loan_application_action_window" model="ir.actions.act_window">
        <field name="name">Employee Application for Grant Loan/Adv</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pak.emp.grant.loan.application</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="emp_grant_loan_application_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="emp_grant_loan_application_menu"
              name="Employee Application for Grant Loan/Adv"
              parent="hr_payroll.menu_hr_payroll_report"
              action="emp_grant_loan_application_action_window"
              sequence="117"/>

</odoo>

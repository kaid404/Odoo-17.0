<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="account_move_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="slc_id" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="action_student_move_out_refund_type" model="ir.actions.act_window">
        <field name="name">Refund</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_out_credit_note_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_refund'),('student_id','!=',False)]</field>
        <field name="context">{'default_move_type': 'out_refund', 'display_account_trust': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a Refund
          </p>
        </field>
    </record>


    <menuitem name="Student Refund"
              id="menu_refund_form"
              parent="gxs_school_fee.menu_generate_monthly_invoices_1"
              action="action_student_move_out_refund_type"
              sequence="51"/>

</odoo>

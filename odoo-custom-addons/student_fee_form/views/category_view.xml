<odoo>
    <data>

        <record id="view_category_form" model="ir.ui.view">
            <field name="name">Fee Category</field>
            <field name="model">op.categoryy</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_increment" string="Compute" type="object" class="btn-success"
                                invisible="show_recompute"/>
                        <button name="action_recompute" string="Re-Compute" type="object" class="btn-primary"
                                invisible="not show_recompute" confirm="Are you sure you want to recompute?"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="increment_fee"/>
                            </group>
                            <group>
                                <field name="show_recompute" invisible="1"/>
                                <field name="fee_add_date" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_category_tree" model="ir.ui.view">
            <field name="name">Fee Category</field>
            <field name="model">op.categoryy</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="increment_fee"/>
                    <field name="fee_add_date"/>
                </tree>
            </field>
        </record>


        <record id="action_fee_category1" model="ir.actions.act_window">
            <field name="name">Fee Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.categoryy</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="server_action_fee" model="ir.actions.server">
            <field name="name">Mark Old Student</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="binding_model_id" ref="model_op_student"/>
            <field name="state">code</field>
            <field name="code">
record = env['op.categoryy'].search([], limit=1);
record.compute_amount_fee()
            </field>
        </record>

        <menuitem id="student_fee_category_menu"
                  name="Fee Category"
                  parent="gxs_core.menu_op_student_root"
                  action="action_fee_category1"
                  sequence="20"/>
    </data>
</odoo>
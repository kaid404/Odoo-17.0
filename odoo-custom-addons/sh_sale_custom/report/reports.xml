<?xml version="1.0"?>
<odoo>
	<record id="sh_saleorder_retailer_paperformat" model="report.paperformat">
        <field name="name">Sale Custom Retailer</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">31</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>
    
    <record id="sh_action_saleorder_retailer_report_template" model="ir.actions.report">
        <field name="name">Quotation / Order Retailer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_sale_custom.saleorder_retailer_report</field>
        <field name="report_file">sh_sale_custom.saleorder_retailer_report</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation Retailer - %s' % (object.name)) or 'Order Retailer - %s' % (object.name)</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sh_sale_custom.sh_saleorder_retailer_paperformat" />
    </record>
    
    <record id="sh_action_invoice_retailer_report_template" model="ir.actions.report">
        <field name="name">Invoice Retailer</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_sale_custom.invoice_retailer_report</field>
        <field name="report_file">sh_sale_custom.invoice_retailer_report</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sh_sale_custom.sh_saleorder_retailer_paperformat" />
    </record>

	<record id="sh_action_stock_retailer_report_template" model="ir.actions.report">
        <field name="name">Delivery Slip Retailer</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_sale_custom.stock_retailer_report</field>
        <field name="report_file">sh_sale_custom.stock_retailer_report</field>
        <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sh_sale_custom.sh_saleorder_retailer_paperformat" />
    </record>
</odoo>

<odoo>
    <odoo>
        <template id="report_evaluation_form">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <!-- Header -->
                            <h2 style="text-align:center;">Candidate Evaluation Form</h2>
                            <table style="width:100%; border:1px solid black; border-collapse:collapse; margin-bottom:10px;">
                                <tr>
                                    <td style="border:1px solid black; padding:5px;">
                                        <b>Candidate Name:</b>
                                        <t t-esc="o.candidate_name.display_name or ''"/>
                                    </td>
                                    <td style="border:1px solid black; padding:5px;">
                                        <b>Job Title:</b>
                                        <t t-esc="o.position.name or ''"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid black; padding:5px;">
                                        <b>Interviewer Name:</b>
                                        <t t-esc="o.interviewer_name.name or ''"/>
                                    </td>
                                    <td style="border:1px solid black; padding:5px;">
                                        <b>Team Name:</b>
                                        <t t-esc="o.team_id.name or ''"/>
                                    </td>
                                </tr>
                            </table>

                            <p>
                                <i>* Each factor contains a maximum of 10 marks.</i>
                            </p>

                            <!-- Evaluation Factors -->
                            <table style="width:100%; border:1px solid black; border-collapse:collapse;">
                                <thead>
                                    <tr>
                                        <th style="border:1px solid black; padding:5px;">Evaluation Factors</th>
                                        <th style="border:1px solid black; padding:5px; text-align:center;">Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.evaluation_line_ids" t-as="line">
                                        <tr>
                                            <td style="border:1px solid black; padding:5px;">
                                                <t t-esc="line.evaluation_factors"/>
                                            </td>
                                            <td style="border:1px solid black; padding:5px; text-align:center;">
                                                <t t-esc="dict(line._fields['score'].selection).get(line.score) or ''"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Total Marks -->
                            <div style="margin-top:10px; text-align:right;">
                                <strong>Total Score:</strong>
                                <t t-esc="o.total_marks"/>
                            </div>

                            <h4>Scoring:</h4>
                            <table style="width:100%; border:1px solid black; border-collapse:collapse; text-align:center;">
                                <tr>
                                    <td style="border:1px solid black; padding:5px;">Not Recommend</td>
                                    <td style="border:1px solid black; padding:5px;">Maybe in Future</td>
                                    <td style="border:1px solid black; padding:5px;">Recommend</td>
                                    <td style="border:1px solid black; padding:5px;">Highly Recommend</td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid black; padding:5px;">
                                        <span t-esc="'☑' if o.scoring == 'not_recommend' else '☐'"/>
                                        20 - 40
                                    </td>
                                    <td style="border:1px solid black; padding:5px;">
                                        <span t-esc="'☑' if o.scoring == 'maybe_in_future' else '☐'"/>
                                        40 - 60
                                    </td>
                                    <td style="border:1px solid black; padding:5px;">
                                        <span t-esc="'☑' if o.scoring == 'recommend' else '☐'"/>
                                        60 - 80
                                    </td>
                                    <td style="border:1px solid black; padding:5px;">
                                        <span t-esc="'☑' if o.scoring == 'highly_recommend' else '☐'"/>
                                        80 - 100
                                    </td>
                                </tr>
                            </table>

                            <!-- Remarks Section -->
                            <h4 style="margin-top:15px;">Remarks &amp; Recommendations:</h4>
                            <div style="min-height:60px; border:1px solid black; padding:5px;">
                                <t t-esc="o.remarks or ''"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </odoo>

    <record id="evaluation_form_report" model="ir.actions.report">
        <field name="name">Print Evaluation Form</field>
        <field name="model">evaluation.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">evaluation_form.report_evaluation_form</field>
        <field name="report_file">evaluation_form.report_evaluation_form</field>
        <field name="binding_model_id" ref="model_evaluation_form"/>
        <field name="binding_type">report</field>
    </record>


</odoo>

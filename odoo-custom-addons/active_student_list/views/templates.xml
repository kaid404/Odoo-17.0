                    </div>
                </t>
            </t>
        </template>


        <record id="active_student_list_paper_format" model="report.paperformat">
            <field name="name">Paper Format for Active Student List Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
        </record>

        <record id="active_student_action_report" model="ir.actions.report">
            <field name="name">Active Student List</field>
            <field name="model">active.student.list</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">active_student_list.active_student_list_report</field>
            <field name="report_file">active_student_list.active_student_list_report</field>
            <field name="paperformat_id" ref="active_student_list.active_student_list_paper_format"/>
            <field name="binding_type">report</field>
        </record>

    </data>

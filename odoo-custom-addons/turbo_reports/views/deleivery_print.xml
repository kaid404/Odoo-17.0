    <record id="action_report_delivery_custom" model="ir.actions.report">
        <field name="name">Delivery Slip Print</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">turbo_reports.report_deliveryslip_custom</field>
        <field name="report_file">turbo_reports.report_deliveryslip_custom</field>
        <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <!--        <field name="binding_model_id" ref="stock.model_stock_picking"/>-->
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <template id="turbo_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@class='col-auto'][2]/p[1]" position="replace">
            <p t-if="o.state == 'done'" t-esc="o.date_done.date().strftime('%d-%m-%Y')"/>
        </xpath>
        <xpath expr="//div[@class='col-auto'][2]/p[2]" position="replace">
            <p t-else="" t-esc="o.scheduled_date.date().strftime('%d-%m-%Y')"/>

        </xpath>
    </template>





                                                    <span t-foreach="lines.service_task_ids" t-as="task">
                                                        <span t-field="task.name"/>
                                                        <br/>
                                                    </span>
                                                </t>
                                            </td>
                                            <td style="text-align:left;">
                                                <span t-field="lines.hs_code"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <span t-field="lines.quantity"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <span t-field="lines.product_uom_id.name"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <span t-esc="'{:,}'.format(round(lines.price_unit, 2))">9.00</span>
                                            </td>
                                            <td name="td_subtotal" class="o_price_total" style="text-align:right;">
                                                <span t-esc="'{:,}'.format(round(lines.price_subtotal, 2))">27.00
                                                </span>
                                                <t t-set="amount" t-value="amount + lines.price_subtotal"/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td style="text-align:left;width:60%;">
                                                <span t-field="lines.name"/>
                                                <br/>
                                                <t t-if="lines.move_id.service_invoice">
                                                    <span t-foreach="lines.service_task_ids" t-as="task">
                                                        <span t-field="task.name"/>
                                                        <br/>
                                                    </span>
                                                </t>
                                            </td>
                                            <td style="text-align:left;">
                                                <span t-field="lines.hs_code"/>
                                            </td>
                                            <td>
                                                <t t-esc="lines.quantity"/>
                                                <t t-set="total_quantity" t-value="total_quantity + lines.quantity"/>
                                            </td>
                                            <td>
                                                <t t-esc="'{:,}'.format(round(lines.price_unit, 2))"/>
                                                <t t-set="total_price" t-value="total_price + lines.price_unit"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <t t-set="amount" t-value="amount + lines.price_subtotal"/>
                                                <t t-esc="'{:,}'.format(round(lines.price_subtotal, 2))"/>
                                                <t t-esc="o.currency_id.symbol"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>

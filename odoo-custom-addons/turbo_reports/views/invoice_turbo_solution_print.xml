                        color:white;
                        border:none;
                        }
                        tbody{
                        border:none;
                        }
                        table th,
                        table td{
                        font-size:11px;
                        text-align:center;
                        border:none;
                        padding:6px;
                        }
                        table tr{
                        border:none;
                        border-bottom:1px solid silver;
                        }
                        #terms_conditions p{
                        line-height:1.5;
                        font-size:11px;
                        margin:0;
                        padding:0;
                        margin-bottom:7px;
                        }

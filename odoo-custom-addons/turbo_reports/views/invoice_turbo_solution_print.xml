    <record id="account_invoices_turbo_solution" model="ir.actions.report">
        <field name="name">Invoices Turbo Solution</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">turbo_reports.report_invoice_turbo_solution</field>
        <field name="report_file">turbo_reports.report_invoice_turbo_solution</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <!--        <field name="binding_model_id" ref="account.model_account_move"/>-->
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="turbo_direct_sale.turbo_solutions_report_format"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
    </record>


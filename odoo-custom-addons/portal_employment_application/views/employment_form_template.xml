<odoo>
    <data>
        <record id="email_template_employment_form" model="mail.template">
            <field name="name">Employment Form Email</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Employment Application Form</field>
            <field name="email_from">{{ user.company_id.email }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello  <t t-out="object.partner_name or object.name"/>,</p>
                    <p>Please fill out your employment application form the following link:</p>
                    <p>
                        <a href="https://game-district.odoo.com/employment/application">Employment Form</a>
                    </p>
                    <p>Thanks!</p>
                </div>
            </field>
        </record>

    </data>
</odoo>

<odoo>
    <record id="view_hr_applicant_form_inherit_employement_form" model="ir.ui.view">
        <field name="name">hr.applicant.inherit.employment.form</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_employment_form" string="Send Employment Form" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>